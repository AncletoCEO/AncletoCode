{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AncletoCode",
  "version": "0.1.0",
  "identifier": "com.ancleto.code",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AncletoCode",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/**"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}

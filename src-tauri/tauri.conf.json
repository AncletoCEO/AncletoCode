{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AncletoCode",
  "version": "0.0.3",
  "identifier": "com.ancleto.code",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AncletoCode",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ancleto",
    "copyright": "Copyright © 2026 Ancleto",
    "category": "DeveloperTool",
    "shortDescription": "Workspace de agentes de código para escritorio y terminal",
    "longDescription": "AncletoCode organiza proyectos, sesiones de agente y conocimiento en un solo workspace, compartido con AncletoCMD y la CLI acode.",
    "resources": [
      "resources/LICENSE",
      "resources/THIRD_PARTY_NOTICES.md",
      "resources/ancleto"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [
      "binaries/ancleto-node"
    ]
  }
}

{
  "name": "ancleto-code",
  "private": true,
  "version": "0.0.6",
  "description": "Workspace de agentes de código para escritorio y terminal: AncletoCode, AncletoCMD y CLI acode.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/license-check.mjs",
    "license:check:npm": "node scripts/npm-license-check.mjs",
    "license:check:rust": "cargo deny --manifest-path src-tauri/Cargo.toml check licenses advisories",
    "check:core-deps": "node scripts/check-core-deps.mjs",
    "sync:pandacode": "node scripts/sync-pandacode.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "package:npm": "node scripts/package-npm.mjs",
    "smoke:npm": "node scripts/smoke-npm.mjs",
    "set:version": "node scripts/set-version.mjs",
    "perf:cmd": "node scripts/perf-cmd.mjs",
    "package:desktop": "node scripts/package-desktop-tarball.mjs",
    "package:aur": "node scripts/package-aur.mjs",
    "prepare:ancleto": "node scripts/prepare-ancleto-runtime.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/katex": "0.16.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "extract-zip": "^2.0.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "AGPL-3.0-only"
}
